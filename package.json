{
  "name": "@eivu/ts-comic-compress",
  "version": "2.0.0",
  "description": "Compresses comic books (CBR or CBZ extension) by using webp and decreasing the target height",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./processor": {
      "types": "./dist/processor.d.ts",
      "default": "./dist/processor.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "comic-compress": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/postbuild.js",
    "start": "node --import tsx src/index.ts",
    "dev": "node --import tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "comic",
    "compress",
    "cbr",
    "cbz",
    "webp"
  ],
  "author": "Rob Jenkins",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^4.10.38",
    "sharp": "^0.34.5",
    "yauzl": "^2.10.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "@vitest/coverage-v8": "^4.1.5",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  }
}
